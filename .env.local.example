# Copia este archivo a .env.local (NO se sube a git) y pega tu Access Key real de Web3Forms.
# Consíguela gratis en https://web3forms.com tras verificar tu email.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=tu-access-key-aqui

# Stripe — claves de tu cuenta en https://dashboard.stripe.com/apikeys
# Usa las claves "sk_test_"/"pk_test_" en desarrollo. Solo sustituye por
# las claves "live" cuando quieras cobrar de verdad (y hazlo también en Vercel).
STRIPE_SECRET_KEY=sk_test_tu-clave-secreta-aqui
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_tu-clave-publicable-aqui

# Google Ads (opcional). Elena las rellena en Vercel (Settings → Environment
# Variables) cuando tenga la cuenta; mientras estén vacías no se carga nada
# de Google Ads. Solo se activan si el visitante acepta las cookies.
# - NEXT_PUBLIC_ADS_ID: ID de la etiqueta de Google Ads, formato AW-XXXXXXXXXX
#   (Google Ads → Herramientas → Administrador de etiquetas / Google tag).
# - NEXT_PUBLIC_ADS_CONVERSION_ID: valor "send_to" de la acción de conversión,
#   formato AW-XXXXXXXXXX/AbCdEfGhIjKlMnOpQrSt (Objetivos → Conversiones →
#   la acción → "Configurar la etiqueta manualmente"). Se dispara al hacer
#   clic en WhatsApp o teléfono, al enviar el formulario de presupuesto y
#   en /documentos/pago-exitoso.
NEXT_PUBLIC_ADS_ID=
NEXT_PUBLIC_ADS_CONVERSION_ID=

# Calculadora de precio (app/components/QuoteCalculator.js → app/api/quote).
# Los archivos que el cliente adjunta se envían por email con Resend
# (https://resend.com, API REST, sin dependencia npm). Mientras falte
# RESEND_API_KEY el endpoint responde ok sin enviar nada y la calculadora
# sigue abriendo WhatsApp con el resumen. Rellénalas en Vercel.
# - RESEND_API_KEY: clave "re_…" de https://resend.com/api-keys
# - QUOTE_TO_EMAIL: buzón que recibe las solicitudes (por defecto info@juradaexpress.es)
# - QUOTE_FROM_EMAIL: remitente verificado en Resend (dominio juradaexpress.es
#   verificado en Resend → Domains; hasta entonces sirve onboarding@resend.dev
#   solo para pruebas al email de la cuenta)
RESEND_API_KEY=
QUOTE_TO_EMAIL=info@juradaexpress.es
QUOTE_FROM_EMAIL=Jurada Express <presupuestos@juradaexpress.es>

# Vercel Blob (subida directa de archivos de la calculadora, 02/10/2026):
# BLOB_READ_WRITE_TOKEN lo crea Vercel al conectar un almacén Blob PRIVADO al
# proyecto (Storage > Create > Blob). Sin él, la calculadora usa el envío
# antiguo (archivos < 3,5 MB) y pide el resto por WhatsApp.
BLOB_READ_WRITE_TOKEN=

# Aviso de pagos (04/10/2026): secreto whsec_… del endpoint de Stripe que
# apunta a https://juradaexpress.es/api/stripe-webhook (checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
