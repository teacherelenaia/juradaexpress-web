# Copia este archivo a .env.local (NO se sube a git) y pega tu Access Key real de Web3Forms.
# Consíguela gratis en https://web3forms.com tras verificar tu email.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=tu-access-key-aqui

# Stripe — claves de tu cuenta en https://dashboard.stripe.com/apikeys
# Usa las claves "sk_test_"/"pk_test_" en desarrollo. Solo sustituye por
# las claves "live" cuando quieras cobrar de verdad (y hazlo también en Vercel).
STRIPE_SECRET_KEY=sk_test_tu-clave-secreta-aqui
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_tu-clave-publicable-aqui
